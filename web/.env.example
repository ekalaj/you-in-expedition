# ---- Supabase ----
# Project URL and anon key (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Stripe (OPTIONAL) ----
# Leave these blank to skip payments entirely — the app runs fine without them
# and shows an "early access, free for now" state. Add test keys when ready.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price for the $10/month membership (create it in the Stripe dashboard)
NEXT_PUBLIC_STRIPE_PRICE_ID=
